ESP32_G_DIRECTION=S
ESP32_G_WALK_SECONDS=300

# J/M train at Marcy Av (toward Manhattan)
ESP32_MJ_STOP_ID=M16
ESP32_MJ_DIRECTION=S
ESP32_MJ_WALK_SECONDS=420
